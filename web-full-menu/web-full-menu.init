#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=12
STOP=88

BASE=/data/local/webui-full-menu

mount_present() {
    awk -v target="$1" '$2 == target { found=1 } END { exit !found }' /proc/mounts
}

same_inode() {
    [ -e "$1" ] && [ -e "$2" ] || return 1
    source_inode="$(stat -c '%d:%i' "$1" 2>/dev/null)" || return 1
    target_inode="$(stat -c '%d:%i' "$2" 2>/dev/null)" || return 1
    [ "$source_inode" = "$target_inode" ]
}

mount_owned() {
    mount_present "$2" && same_inode "$1" "$2"
}

mount_file() {
    source="$1"
    target="$2"
    [ -f "$source" ] && [ -f "$target" ] || return 1
    if mount_present "$target"; then
        mount_owned "$source" "$target" && return 0
        # Only the verified, single Manager layer may sit beneath our menu.
        [ -n "${3:-}" ] && same_inode "$3" "$target" || return 1
        count=$(awk -v target="$target" '$2 == target { count++ } END { print count + 0 }' /proc/mounts)
        [ "$count" -eq 1 ] || return 1
    fi
    mount --bind "$source" "$target"
}

unmount_ours() {
    source="$1"
    target="$2"
    while mount_owned "$source" "$target"; do
        umount "$target" 2>/dev/null || return 1
    done
}

start() {
    mount_file "$BASE/index.html" /usr/zte_web/web/index.html /data/mihomo-manager/web-root/index.html || return 1
    mount_file "$BASE/menu.js" /usr/zte_web/web/js/config/ufi/U60Pro/menu.js /data/mihomo-manager/web-root/menu.js || return 1
    mount_file "$BASE/router.js" /usr/zte_web/web/js/router.js || return 1
    mount_file "$BASE/network_lock.html" /usr/zte_web/web/tmpl/auth/network_lock.html
}

stop() {
    unmount_ours "$BASE/network_lock.html" /usr/zte_web/web/tmpl/auth/network_lock.html
    unmount_ours "$BASE/router.js" /usr/zte_web/web/js/router.js
    unmount_ours "$BASE/menu.js" /usr/zte_web/web/js/config/ufi/U60Pro/menu.js
    unmount_ours "$BASE/index.html" /usr/zte_web/web/index.html
}
