#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=11
STOP=89

BASE=/data/mihomo-manager
RPCD_SOURCE="$BASE/rpcd"
ACL_SOURCE="$BASE/acl.d"
JS_SOURCE="$BASE/web/js-auth-adm"
TMPL_SOURCE="$BASE/web/tmpl-auth-adm"
INDEX_SOURCE="$BASE/web-root/index.html"
MENU_SOURCE="$BASE/web-root/menu.js"

is_mounted() {
    awk -v target="$1" '$2 == target { found=1 } END { exit !found }' /proc/mounts
}

same_inode() {
    [ -e "$1" ] && [ -e "$2" ] || return 1
    source_inode="$(stat -c '%d:%i' "$1" 2>/dev/null)" || return 1
    target_inode="$(stat -c '%d:%i' "$2" 2>/dev/null)" || return 1
    [ "$source_inode" = "$target_inode" ]
}

mount_owned() {
    is_mounted "$2" && same_inode "$1" "$2"
}

sync_stock() {
    mkdir -p "$RPCD_SOURCE" "$ACL_SOURCE" "$JS_SOURCE" "$TMPL_SOURCE"

    if ! is_mounted /usr/libexec/rpcd; then
        cp -a /usr/libexec/rpcd/. "$RPCD_SOURCE/" 2>/dev/null || true
    fi
    if ! is_mounted /usr/share/rpcd/acl.d; then
        cp -a /usr/share/rpcd/acl.d/. "$ACL_SOURCE/" 2>/dev/null || true
    fi
    if ! is_mounted /usr/zte_web/web/js/auth/adm; then
        cp -a /usr/zte_web/web/js/auth/adm/. "$JS_SOURCE/" 2>/dev/null || true
    fi
    if ! is_mounted /usr/zte_web/web/tmpl/auth/adm; then
        cp -a /usr/zte_web/web/tmpl/auth/adm/. "$TMPL_SOURCE/" 2>/dev/null || true
    fi
}

mount_one() {
    source="$1"
    target="$2"
    [ -d "$source" ] && [ -d "$target" ] || return 1
    if is_mounted "$target"; then
        mount_owned "$source" "$target"
    else
        mount --bind "$source" "$target"
    fi
}

mount_file() {
    source="$1"
    target="$2"
    [ -f "$source" ] && [ -f "$target" ] || return 1
    if is_mounted "$target"; then
        mount_owned "$source" "$target"
    else
        mount --bind "$source" "$target"
    fi
}

unmount_ours() {
    source="$1"
    target="$2"
    while mount_owned "$source" "$target"; do
        umount "$target" 2>/dev/null || return 1
    done
}

start() {
    sync_stock
    mount_one "$RPCD_SOURCE" /usr/libexec/rpcd || return 1
    mount_one "$ACL_SOURCE" /usr/share/rpcd/acl.d || return 1
    mount_one "$JS_SOURCE" /usr/zte_web/web/js/auth/adm || return 1
    mount_one "$TMPL_SOURCE" /usr/zte_web/web/tmpl/auth/adm || return 1
    mount_file "$INDEX_SOURCE" /usr/zte_web/web/index.html || return 1
    mount_file "$MENU_SOURCE" /usr/zte_web/web/js/config/ufi/U60Pro/menu.js
}

stop() {
    unmount_ours "$MENU_SOURCE" /usr/zte_web/web/js/config/ufi/U60Pro/menu.js
    unmount_ours "$INDEX_SOURCE" /usr/zte_web/web/index.html
    unmount_ours "$TMPL_SOURCE" /usr/zte_web/web/tmpl/auth/adm
    unmount_ours "$JS_SOURCE" /usr/zte_web/web/js/auth/adm
    unmount_ours "$ACL_SOURCE" /usr/share/rpcd/acl.d
    unmount_ours "$RPCD_SOURCE" /usr/libexec/rpcd
}
